async def read_http_request(
    reader: asyncio.StreamReader,
    max_body: int = int(os.environ.get("NEMAPI_MAX_BODY", str(20 * 1024 * 1024))),
) -> Tuple[Optional[str], Optional[str], Dict[str, str], bytes, Dict[str, str]]:
    header_data = b""
    while b"\r\n\r\n" not in header_data and b"\n\n" not in header_data:
        chunk = await asyncio.wait_for(reader.read(4096), timeout=60)
        if not chunk:
            break
        header_data += chunk
        if len(header_data) > 65536:
            break

    if not header_data:
        return None, None, {}, b"", {}

    sep = b"\r\n\r\n" if b"\r\n\r\n" in header_data else b"\n\n"
    if sep in header_data:
        head, rest = header_data.split(sep, 1)
    else:
        head, rest = header_data, b""

    try:
        head_text = head.decode("utf-8", errors="replace")
    except Exception:
        return None, None, {}, b"", {}

    lines = head_text.split("\n")
    if not lines:
        return None, None, {}, b"", {}

    first = lines[0].strip().split(" ")
    if len(first) < 2:
        return None, None, {}, b"", {}
    method, full_path = first[0], first[1]
    parsed = urlparse(full_path)
    path = parsed.path or "/"
    params = {k: v[0] for k, v in parse_qs(parsed.query).items()}

    headers: Dict[str, str] = {}
    for line in lines[1:]:
        line = line.strip("\r")
        if ":" in line:
            k, v = line.split(":", 1)
            headers[k.strip().lower()] = v.strip()

    content_length = int(headers.get("content-length", "0") or "0")
    body = rest
    if content_length > 0:
        if content_length > max_body:
            content_length = max_body
        while len(body) < content_length:
            need = content_length - len(body)
            chunk = await asyncio.wait_for(
                reader.read(min(need, 65536)), timeout=120
            )
            if not chunk:
                break
            body += chunk
        body = body[:content_length]

    ctype = headers.get("content-type", "")
    if method == "POST" and body and "application/x-www-form-urlencoded" in ctype:
        try:
            form = parse_qs(body.decode("utf-8", errors="replace"), keep_blank_values=True)
            for k, v in form.items():
                params[k] = v[0] if v else ""
        except Exception:
            pass

    return method, path, params, body, headers


def build_response(status: int, body: Any, content_type: str = "application/json") -> bytes:
    status_msgs = {
        200: "OK",
        400: "Bad Request",
        404: "Not Found",
        405: "Method Not Allowed",
        500: "Internal Server Error",
        502: "Bad Gateway",
        503: "Service Unavailable",
    }
    msg = status_msgs.get(status, "OK")
    if isinstance(body, (dict, list)):
        body_bytes = json.dumps(body, ensure_ascii=False).encode("utf-8")
        content_type = "application/json"
    elif isinstance(body, str):
        body_bytes = body.encode("utf-8")
    else:
        body_bytes = body or b""

    headers = (
        f"HTTP/1.1 {status} {msg}\r\n"
        f"Content-Type: {content_type}; charset=utf-8\r\n"
        f"Content-Length: {len(body_bytes)}\r\n"
        "Access-Control-Allow-Origin: *\r\n"
        "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
        "Access-Control-Allow-Headers: Content-Type, Authorization, X-NEMAPI-New-Chat\r\n"
        "Connection: close\r\n"
        "\r\n"
    )
    return headers.encode("utf-8") + body_bytes


