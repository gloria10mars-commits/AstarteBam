_MAX_FILE_BYTES = int(os.environ.get("NEMAPI_MAX_FILE_BYTES", str(12 * 1024 * 1024)))
_MAX_FILES_PER_JOB = int(os.environ.get("NEMAPI_MAX_FILES", "5"))


def _guess_mime(name: str, fallback: str = "application/octet-stream") -> str:
    mime, _ = mimetypes.guess_type(name or "")
    return mime or fallback


def _normalize_file_entry(raw: Dict[str, Any], idx: int = 0) -> Optional[Dict[str, str]]:
    """Normalise un fichier vers {name, mime, content_base64}."""
    if not isinstance(raw, dict):
        return None
    name = (
        raw.get("name")
        or raw.get("filename")
        or raw.get("file_name")
        or f"file_{idx}.bin"
    )
    mime = raw.get("mime") or raw.get("type") or raw.get("content_type") or ""
    b64 = (
        raw.get("content_base64")
        or raw.get("base64")
        or raw.get("data")
        or raw.get("content")
        or ""
    )
    # data URL : data:mime;base64,....
    if isinstance(b64, str) and b64.startswith("data:") and "," in b64:
        header, b64 = b64.split(",", 1)
        if ";base64" in header and ":" in header:
            mime = mime or header.split(":")[1].split(";")[0]
    if not b64 or not isinstance(b64, str):
        return None
    b64 = re.sub(r"\s+", "", b64)
    try:
        raw_bytes = base64.b64decode(b64, validate=False)
    except Exception:
        return None
    if len(raw_bytes) > _MAX_FILE_BYTES:
        raise ValueError(
            f"Fichier trop volumineux: {name} ({len(raw_bytes)} > {_MAX_FILE_BYTES} octets)"
        )
    if not mime:
        mime = _guess_mime(str(name))
    return {
        "name": str(name),
        "mime": str(mime),
        "content_base64": base64.b64encode(raw_bytes).decode("ascii"),
    }


def extract_files_from_messages(
    messages: List[Dict[str, Any]],
) -> List[Dict[str, str]]:
    """Extrait fichiers depuis content parts OpenAI (image_url, file, input_file)."""
    out: List[Dict[str, str]] = []
    for msg in messages or []:
        content = msg.get("content")
        if not isinstance(content, list):
            continue
        for part in content:
            if not isinstance(part, dict):
                continue
            ptype = (part.get("type") or "").lower()
            entry: Optional[Dict[str, Any]] = None
            if ptype in ("image_url", "input_image"):
                img = part.get("image_url") or part.get("image") or {}
                if isinstance(img, str):
                    url = img
                else:
                    url = (img or {}).get("url") or ""
                if isinstance(url, str) and url.startswith("data:"):
                    entry = {
                        "name": part.get("name") or f"image_{len(out)}.png",
                        "content": url,
                    }
            elif ptype in ("file", "input_file", "document"):
                fobj = part.get("file") or part
                entry = {
                    "name": fobj.get("filename")
                    or fobj.get("name")
                    or part.get("name")
                    or f"file_{len(out)}.bin",
                    "mime": fobj.get("mime") or fobj.get("content_type"),
                    "content_base64": fobj.get("file_data")
                    or fobj.get("content_base64")
                    or fobj.get("data"),
                }
                # parfois file_data est data URL
                fd = entry.get("content_base64")
                if not fd and isinstance(fobj.get("file_data"), str):
                    entry["content_base64"] = fobj["file_data"]
            if entry:
                try:
                    norm = _normalize_file_entry(entry, len(out))
                except ValueError as e:
                    raise
                if norm:
                    out.append(norm)
            if len(out) >= _MAX_FILES_PER_JOB:
                return out
    return out


def extract_files_from_payload(payload: Dict[str, Any]) -> List[Dict[str, str]]:
    """Fichiers depuis body : nemapi_files, files, ou messages."""
    out: List[Dict[str, str]] = []
    for key in ("nemapi_files", "files", "attachments"):
        block = payload.get(key)
        if not isinstance(block, list):
            continue
        for i, raw in enumerate(block):
            if isinstance(raw, dict):
                norm = _normalize_file_entry(raw, i)
                if norm:
                    out.append(norm)
            if len(out) >= _MAX_FILES_PER_JOB:
                return out
    # messages OpenAI multi-part
    try:
        from_msgs = extract_files_from_messages(payload.get("messages") or [])
    except ValueError:
        raise
    for f in from_msgs:
        if len(out) >= _MAX_FILES_PER_JOB:
            break
        # dédup par nom+taille approx
        if not any(x["name"] == f["name"] and x["mime"] == f["mime"] for x in out):
            out.append(f)
    return out


def extract_tool_calls(text: str) -> Tuple[Optional[str], List[Dict[str, Any]]]:
    """Extrait tool_calls OpenAI depuis texte libre / markdown / XML."""
    if not text or not text.strip():
        return text, []

    def _fix(blob: str) -> str:
        blob = re.sub(r",\s*}", "}", blob)
        blob = re.sub(r",\s*]", "]", blob)
        return blob

    def _items_from_data(data: Any) -> List[Dict[str, Any]]:
        items: List[Any] = []
        if isinstance(data, dict):
            if "tool_calls" in data:
                items = data["tool_calls"] or []
            elif "tools" in data and isinstance(data["tools"], list):
                items = data["tools"]
            elif "name" in data or "function" in data:
                items = [data]
            elif "tool" in data and isinstance(data["tool"], str):
                items = [
                    {
                        "name": data["tool"],
                        "arguments": data.get("arguments")
                        or data.get("params")
                        or {},
                    }
                ]
        elif isinstance(data, list):
            items = data
        out: List[Dict[str, Any]] = []
        for item in items:
            if not isinstance(item, dict):
                continue
            if "function" in item and isinstance(item["function"], dict):
                fn = item["function"]
                name = fn.get("name", "")
                args = fn.get("arguments", {})
            else:
                name = item.get("name") or item.get("tool") or ""
                args = item.get(
                    "arguments", item.get("parameters", item.get("params", {}))
                )
            if not name:
                continue
            name = str(name).strip()
            if isinstance(args, str):
                try:
                    args = json.loads(args)
                except json.JSONDecodeError:
                    args = {"_raw": args}
            if not isinstance(args, dict):
                args = {"value": args}
            tid = item.get("id") or f"call_{uuid.uuid4().hex[:12]}"
            out.append(
                {
                    "id": tid,
                    "type": "function",
                    "function": {
                        "name": name,
                        "arguments": json.dumps(args, ensure_ascii=False),
                    },
                }
            )
        return out

    def _try_parse(blob: str) -> List[Dict[str, Any]]:
        for candidate in (blob, _fix(blob)):
            try:
                data = json.loads(candidate)
                found = _items_from_data(data)
                if found:
                    return found
            except json.JSONDecodeError:
                continue
        return []

    for m in re.finditer(
        r"<(?:tool_call|tool_calls|function_call)\b[^>]*>([\s\S]*?)</(?:tool_call|tool_calls|function_call)>",
        text,
        re.I,
    ):
        found = _try_parse(m.group(1).strip())
        if found:
            cleaned = re.sub(r"\n{3,}", "\n\n", (text[: m.start()] + text[m.end() :]).strip())
            return cleaned or None, found

    for m in re.finditer(r"```(?:json|JSON)?\s*([\s\S]*?)```", text):
        found = _try_parse(m.group(1).strip())
        if found:
            cleaned = re.sub(
                r"\n{3,}", "\n\n", (text[: m.start()] + text[m.end() :]).strip()
            )
            return cleaned or None, found

    stripped = text.strip()
    if stripped.startswith("{") or stripped.startswith("["):
        found = _try_parse(stripped)
        if found:
            return None, found

    start = text.find("{")
    while start != -1:
        depth = 0
        in_str = False
        esc = False
        for i in range(start, len(text)):
            ch = text[i]
            if in_str:
                if esc:
                    esc = False
                elif ch == "\\":
                    esc = True
                elif ch == '"':
                    in_str = False
                continue
            if ch == '"':
                in_str = True
            elif ch == "{":
                depth += 1
            elif ch == "}":
                depth -= 1
                if depth == 0:
                    blob = text[start : i + 1]
                    if any(
                        k in blob
                        for k in (
                            "tool_calls",
                            '"name"',
                            '"tool"',
                            "run_bash",
                            "write_file",
                            "read_file",
                        )
                    ):
                        found = _try_parse(blob)
                        if found:
                            cleaned = (text[:start] + text[i + 1 :]).strip()
                            return cleaned or None, found
                    break
        start = text.find("{", start + 1)

    return text, []


