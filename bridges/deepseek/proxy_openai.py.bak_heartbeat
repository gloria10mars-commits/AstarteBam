class BrowserSession:
    """État logique d'une conversation unique côté onglet."""

    def __init__(self) -> None:
        self.id: str = str(uuid.uuid4())
        self.created_at: float = time.time()
        self.turn_count: int = 0  # nb de jobs complétés avec succès
        self.has_sent_user_message: bool = False
        self.system_seeded: bool = False
        self.last_user_blob: str = ""
        self.last_assistant: str = ""
        self.last_job_id: Optional[str] = None

    def reset(self) -> None:
        self.id = str(uuid.uuid4())
        self.created_at = time.time()
        self.turn_count = 0
        self.has_sent_user_message = False
        self.system_seeded = False
        self.last_user_blob = ""
        self.last_assistant = ""
        self.last_job_id = None

    def to_dict(self) -> Dict[str, Any]:
        return {
            "id": self.id,
            "created_at": self.created_at,
            "turn_count": self.turn_count,
            "has_sent_user_message": self.has_sent_user_message,
            "system_seeded": self.system_seeded,
            "last_user_preview": (self.last_user_blob or "")[:120],
            "last_assistant_preview": (self.last_assistant or "")[:120],
        }


browser_session = BrowserSession()


