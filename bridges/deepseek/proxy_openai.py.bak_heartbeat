    return 200, {"action": "idle"}, "application/json"


async def handle_post_result(
    params: Dict[str, str], body: bytes = b"", headers: Optional[Dict[str, str]] = None
) -> Tuple[int, Any, str]:
    headers = headers or {}
    ctype = headers.get("content-type", "")
    if body and "application/json" in ctype:
        try:
            data = json.loads(body.decode("utf-8", errors="replace"))
            if isinstance(data, dict):
                for k, v in data.items():
                    if v is None:
                        continue
                    if k == "result" and not isinstance(v, str):
                        params[k] = json.dumps(v, ensure_ascii=False)
                    else:
                        params[k] = v if isinstance(v, str) else str(v)
        except json.JSONDecodeError:
            pass

    job_id = params.get("jobId") or params.get("job_id")
    action = params.get("action", "result")
    if not job_id:
        return 400, "jobId manquant", "text/plain"
    if action == "result":
        await jobs_manager.set_result(job_id, params.get("result", ""))
    elif action in ("error", "stopped"):
        err = params.get("error") or params.get("result") or "Erreur"
        await jobs_manager.set_error(job_id, err if action == "error" else "ANNULÉ")
    else:
        return 400, "Action inconnue", "text/plain"
    return 200, "OK", "text/plain"


def _want_new_chat(payload: Dict[str, Any], headers: Dict[str, str]) -> bool:
    if headers.get("x-nemapi-new-chat", "").lower() in ("1", "true", "yes"):
        return True
    if payload.get("nemapi_new_chat") or payload.get("new_chat"):
        return True
    # convention OpenAI metadata
    meta = payload.get("metadata") or {}
    if isinstance(meta, dict) and meta.get("new_chat"):
        return True
    return False


async def handle_chat_completions(
    body: bytes, headers: Optional[Dict[str, str]] = None
) -> Tuple[int, Any, str]:
    headers = headers or {}
    try:
        payload = json.loads(body.decode("utf-8") if body else "{}")
    except json.JSONDecodeError as e:
        return (
            400,
            {
                "error": {
                    "message": f"JSON invalide: {e}",
                    "type": "invalid_request_error",
                }
            },
            "application/json",
        )

    messages = payload.get("messages") or []
    model = payload.get("model") or "deepseek-web"
    tools = payload.get("tools")
    tool_choice = payload.get("tool_choice", "auto")
    stream = payload.get("stream", False)

    if stream:
        return (
            400,
            {
                "error": {
                    "message": "stream non supporté par le bridge navigateur",
                    "type": "invalid_request_error",
                }
            },
            "application/json",
        )

    try:
        files = extract_files_from_payload(payload)
    except ValueError as e:
        return (
            400,
            {"error": {"message": str(e), "type": "invalid_request_error"}},
            "application/json",
        )

    if not messages and not files:
        return (
            400,
            {
                "error": {
                    "message": "messages requis (ou fichiers via nemapi_files)",
                    "type": "invalid_request_error",
                }
            },
            "application/json",
        )

    if _want_new_chat(payload, headers):
        browser_session.reset()
        print(f"[SESSION] reset → {browser_session.id[:8]}")

    # Toujours send via le composer. System + tools seed une fois par session.
    mode = "send"
    include_system = not browser_session.system_seeded

    text = ""
    if messages:
        text = pack_delta_for_browser(
            messages,
            tools=tools,
            tool_choice=tool_choice,
            include_system=include_system,
            session=browser_session,
        )
    if files and not text.strip():
        names = ", ".join(f["name"] for f in files)
        text = (
            f"[USER]\nAnalyse le(s) fichier(s) joint(s) : {names}. "
            "Résume le contenu et les points importants."
        )

    print(
        f"[OPENAI] chat mode={mode} msgs={len(messages)} "
        f"tools={len(tools or [])} chars={len(text)} files={len(files)} "
        f"session={browser_session.id[:8]}"
    )

    job_id = await jobs_manager.create_job(
        text,
        mode=mode,
        meta={
            "session_id": browser_session.id,
            "turn": browser_session.turn_count + 1,
            "include_system": include_system,
            "files": files,
        },
    )
    browser_session.last_job_id = job_id
    browser_session.last_user_blob = text

    timeout = float(os.environ.get("NEMAPI_TIMEOUT", "600"))
    outcome = await jobs_manager.wait_job(job_id, timeout=timeout)

    if outcome["status"] == "error":
        return (
            502,
            {
                "error": {
                    "message": outcome.get("result") or "Erreur bridge",
                    "type": "bridge_error",
                    "session_id": browser_session.id,
                    "mode": mode,
                }
            },
            "application/json",
        )

    raw = outcome.get("result") or ""
    content, tool_calls = extract_tool_calls(raw)

    # Session OK
    browser_session.has_sent_user_message = True
    if include_system:
        browser_session.system_seeded = True
    browser_session.turn_count += 1
    browser_session.last_assistant = content or raw

    message: Dict[str, Any] = {"role": "assistant", "content": content}
    finish_reason = "stop"
    if tool_calls:
        message["tool_calls"] = tool_calls
        if not content:
            message["content"] = None
        finish_reason = "tool_calls"

    response = {
        "id": f"chatcmpl-{uuid.uuid4().hex[:12]}",
        "object": "chat.completion",
        "created": int(time.time()),
        "model": model,
        "choices": [
            {
                "index": 0,
                "message": message,
                "finish_reason": finish_reason,
            }
        ],
        "usage": {
            "prompt_tokens": max(1, len(text) // 4),
            "completion_tokens": max(1, len(raw) // 4),
            "total_tokens": max(1, (len(text) + len(raw)) // 4),
        },
        "nemapi": {
            "session_id": browser_session.id,
            "mode": mode,
            "turn": browser_session.turn_count,
            "files": [f["name"] for f in files],
        },
    }
    print(
        f"[OPENAI] → finish={finish_reason} tools={len(tool_calls)} "
        f"mode={mode} turn={browser_session.turn_count} files={len(files)}"
    )
    return 200, response, "application/json"


async def handle_files(
    body: bytes, headers: Optional[Dict[str, str]] = None
) -> Tuple[int, Any, str]:
    """POST /v1/files — attache des fichiers à DeepSeek, optionnellement pose une question.

    Body JSON :
      {
        "files": [{"name":"a.pdf","content_base64":"...","mime":"application/pdf"}],
        "prompt": "Résume ce document",   // optionnel
        "upload_only": false,             // true = attach sans envoyer
        "model": "deepseek-web"
      }

    Ou un seul fichier :
      {"name":"a.pdf","content_base64":"...","prompt":"..."}
    """
    headers = headers or {}
    try:
        payload = json.loads(body.decode("utf-8") if body else "{}")
    except json.JSONDecodeError as e:
        return (
            400,
            {"error": {"message": f"JSON invalide: {e}", "type": "invalid_request_error"}},
            "application/json",
        )

    if not isinstance(payload, dict):
        return (
            400,
            {"error": {"message": "objet JSON requis", "type": "invalid_request_error"}},
            "application/json",
        )

    # Normaliser liste files
    if "files" not in payload and (
        payload.get("content_base64") or payload.get("base64") or payload.get("data")
    ):
        payload = {
            "files": [payload],
            "prompt": payload.get("prompt") or payload.get("question") or "",
            "upload_only": payload.get("upload_only", False),
            "model": payload.get("model") or "deepseek-web",
        }

    try:
        files = extract_files_from_payload(payload)
    except ValueError as e:
        return (
            400,
            {"error": {"message": str(e), "type": "invalid_request_error"}},
            "application/json",
        )

    if not files:
        return (
            400,
            {
                "error": {
                    "message": "Aucun fichier (files[].content_base64 requis)",
                    "type": "invalid_request_error",
                }
            },
            "application/json",
        )

    prompt = (
        payload.get("prompt")
        or payload.get("question")
        or payload.get("message")
        or ""
    )
    upload_only = bool(payload.get("upload_only") or payload.get("uploadOnly"))
    model = payload.get("model") or "deepseek-web"

    if not upload_only and not str(prompt).strip():
        names = ", ".join(f["name"] for f in files)
        prompt = (
            f"Analyse le(s) fichier(s) joint(s) : {names}. "
            "Résume le contenu et les points importants."
        )

    text = f"[USER]\n{prompt}" if str(prompt).strip() else ""

    print(
        f"[FILES] attach={len(files)} upload_only={upload_only} "
        f"prompt_chars={len(prompt)} session={browser_session.id[:8]}"
    )
    for f in files:
        approx = len(f["content_base64"]) * 3 // 4
        print(f"[FILES]   · {f['name']} ({f['mime']}, ~{approx} o)")

    job_id = await jobs_manager.create_job(
        text,
        mode="send",
        meta={
            "session_id": browser_session.id,
            "files": files,
            "upload_only": upload_only,
            "kind": "files",
        },
    )
    browser_session.last_job_id = job_id
    browser_session.last_user_blob = text or f"[files:{len(files)}]"

    timeout = float(os.environ.get("NEMAPI_TIMEOUT", "600"))
    outcome = await jobs_manager.wait_job(job_id, timeout=timeout)

    if outcome["status"] == "error":
        return (
            502,
            {
                "error": {
                    "message": outcome.get("result") or "Erreur bridge fichiers",
                    "type": "bridge_error",
                    "session_id": browser_session.id,
                }
            },
            "application/json",
        )

    raw = outcome.get("result") or ""
    browser_session.has_sent_user_message = True
    if not upload_only:
        browser_session.turn_count += 1
        browser_session.last_assistant = raw

    # Si résultat JSON d'upload seul
    parsed_upload = None
    if upload_only:
        try:
            parsed_upload = json.loads(raw)
        except Exception:
            parsed_upload = {"ok": True, "raw": raw}

    if upload_only:
        return (
            200,
            {
                "id": f"file-{uuid.uuid4().hex[:12]}",
                "object": "nemapi.file_upload",
                "created": int(time.time()),
                "model": model,
                "files": [{"name": f["name"], "mime": f["mime"]} for f in files],
                "upload": parsed_upload,
                "nemapi": {
                    "session_id": browser_session.id,
                    "upload_only": True,
                },
            },
            "application/json",
        )

    content, tool_calls = extract_tool_calls(raw)
    message: Dict[str, Any] = {"role": "assistant", "content": content}
    finish_reason = "stop"
    if tool_calls:
        message["tool_calls"] = tool_calls
        if not content:
            message["content"] = None
        finish_reason = "tool_calls"

    return (
        200,
        {
            "id": f"chatcmpl-{uuid.uuid4().hex[:12]}",
            "object": "chat.completion",
            "created": int(time.time()),
            "model": model,
            "choices": [
                {
                    "index": 0,
                    "message": message,
                    "finish_reason": finish_reason,
                }
            ],
            "usage": {
                "prompt_tokens": max(1, len(text) // 4),
                "completion_tokens": max(1, len(raw) // 4),
                "total_tokens": max(1, (len(text) + len(raw)) // 4),
            },
            "nemapi": {
                "session_id": browser_session.id,
                "mode": "send",
                "turn": browser_session.turn_count,
                "files": [f["name"] for f in files],
                "kind": "files",
            },
        },
        "application/json",
    )


