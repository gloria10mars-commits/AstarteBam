#!/usr/bin/env python3
"""
NEMAPI Bridge — Proxy OpenAI compatible (send + delta + files)

Modèle d'interaction navigateur (DeepSeek) :
  Chaque tour → SEND dans la barre de texte (composer bas).
  On n'envoie QUE le message courant (delta) : le contexte multi-tour
  est déjà géré par les serveurs DeepSeek sur l'onglet / le fil ouvert.
  Fichiers → attach UI DeepSeek puis prompt d'analyse.
  Pas de regenerate / edit (limite plateforme ~7).

L'API reste OpenAI :
  POST /v1/chat/completions
  POST /v1/files            — upload (+ prompt optionnel)
  GET  /v1/models
  POST /v1/sessions/reset   — nouveau fil logique
  GET  /v1/session          — état session

L'extension reçoit des jobs :
  { action, jobId, mode: "send", text, meta: { files?, upload_only? } }
"""

from __future__ import annotations

