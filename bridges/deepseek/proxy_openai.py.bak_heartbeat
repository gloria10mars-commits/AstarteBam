        return 200, "STILL_WORKING", "text/plain"
    if job["status"] == "completed":
        return 200, job.get("result") or "", "text/plain"
    return 500, job.get("result") or "Erreur", "text/plain"


async def route(
    method: str,
    path: str,
    params: Dict[str, str],
    body: bytes,
    headers: Optional[Dict[str, str]] = None,
) -> Tuple[int, Any, str]:
    headers = headers or {}
    if method == "OPTIONS":
        return 200, "", "text/plain"

    if path == "/job" and method == "GET":
        return await handle_poll_jobs()
    if path == "/job" and method == "POST":
        return await handle_post_result(params, body=body, headers=headers)

    if path in ("/v1/chat/completions", "/chat/completions") and method == "POST":
        return await handle_chat_completions(body, headers=headers)
    if path in ("/v1/files", "/files", "/v1/files/analyze", "/files/analyze") and method == "POST":
        return await handle_files(body, headers=headers)
    if path in ("/v1/models", "/models") and method == "GET":
        return handle_models()

    if path in ("/v1/session", "/session") and method == "GET":
        return handle_session_get()
    if path in ("/v1/sessions/reset", "/sessions/reset", "/v1/session/reset") and method == "POST":
        return await handle_session_reset()

    if path in ("/health", "/status") and method == "GET":
        return (
            200,
            {
                "status": "ok",
                "service": "nemapi-bridge-openai",
                "version": "2.4",
                "features": ["send", "delta", "files"],
                "session": browser_session.to_dict(),
            },
            "application/json",
        )

    if path == "/stop" and method == "GET":
        await jobs_manager.cancel_all()
        return 200, "STOP_SENT", "text/plain"

    if path == "/ask" and method in ("GET", "POST"):
        return await handle_ask(params)
    if path == "/result" and method == "GET":
        return await handle_result(params)

    if path == "/" and method == "GET":
        return handle_index()

    return 404, {"error": {"message": f"Not Found: {path}"}}, "application/json"


async def handle_client(
    reader: asyncio.StreamReader, writer: asyncio.StreamWriter
) -> None:
    try:
        method, path, params, body, headers = await read_http_request(reader)
        if method is None:
            writer.close()
            return
        print(f"[HTTP] {method} {path} body={len(body)}")
        status, resp_body, ctype = await route(
            method, path, params, body, headers=headers
        )
        if isinstance(resp_body, (dict, list)):
            data = build_response(status, resp_body, "application/json")
        else:
            data = build_response(status, resp_body, ctype)
        writer.write(data)
        await writer.drain()
    except asyncio.TimeoutError:
        try:
            writer.write(
                build_response(
                    500,
                    {"error": {"message": "Timeout lecture requête"}},
                    "application/json",
                )
            )
            await writer.drain()
        except Exception:
            pass
    except Exception as e:
        print(f"[HTTP] Erreur: {e}")
        try:
            writer.write(
                build_response(
                    500, {"error": {"message": str(e)}}, "application/json"
                )
            )
            await writer.drain()
        except Exception:
            pass
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass


