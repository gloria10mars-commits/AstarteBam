TOOL_PROTOCOL = """
═══════════════════════════════════════════════════════════════
PROTOCOLE OUTILS (NEMESIS CLI — obligatoire pour actions)
═══════════════════════════════════════════════════════════════
Pour une action système, réponds avec UNIQUEMENT un bloc JSON :

```json
{"tool_calls":[{"name":"NOM_OUTIL","arguments":{...}}]}
```

Règles :
1. Pas de shell en texte hors JSON.
2. arguments = objet JSON.
3. Sans outil → réponse langage naturel SANS tool_calls.
4. Après résultats d'outils → nouvel outil OU réponse finale.
═══════════════════════════════════════════════════════════════
"""


def _content_to_str(content: Any) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for p in content:
            if isinstance(p, dict):
                if p.get("type") == "text":
                    parts.append(p.get("text", ""))
                else:
                    parts.append(str(p))
            else:
                parts.append(str(p))
        return "\n".join(parts)
    return str(content)


def _describe_tools(tools: Optional[List[Dict[str, Any]]]) -> str:
    if not tools:
        return ""
    lines = ["\n── Outils disponibles ──\n"]
    for tool in tools:
        fn = tool.get("function", tool)
        name = fn.get("name", "?")
        desc = (fn.get("description") or "")[:200]
        params = fn.get("parameters", {}) or {}
        props = params.get("properties", {}) or {}
        required = params.get("required", []) or []
        lines.append(f"• {name}: {desc}")
        for pname, pinfo in list(props.items())[:12]:
            if not isinstance(pinfo, dict):
                continue
            ptype = pinfo.get("type", "any")
            req = "requis" if pname in required else "opt"
            lines.append(f"    - {pname} ({ptype}, {req})")
        lines.append("")
    return "\n".join(lines)


def _is_tool_result_batch(messages: List[Dict[str, Any]]) -> bool:
    if not messages:
        return False
    # Dernier message tool, ou user synthétique de résultats
    last = messages[-1]
    if last.get("role") == "tool":
        return True
    content = _content_to_str(last.get("content"))
    if last.get("role") == "user" and (
        "RÉSULTAT OUTIL" in content
        or "RESULTAT OUTIL" in content
        or "### RÉSULTAT" in content
        or content.strip().startswith("Voici les résultats")
    ):
        return True
    return False


def pack_delta_for_browser(
    messages: List[Dict[str, Any]],
    tools: Optional[List[Dict[str, Any]]] = None,
    tool_choice: Any = "auto",
    *,
    include_system: bool = False,
    session: Optional[BrowserSession] = None,
) -> str:
    """Construit le TEXTE d'UN message (delta) pour le composer DeepSeek.

    Ne re-colle PAS tout l'historique OpenAI : le fil DeepSeek conserve
    déjà la discussion côté serveur. On envoie system (1×), outils si besoin,
    puis le dernier user / batch de résultats d'outils.
    """
    parts: List[str] = []
    include_tools = bool(tools) and tool_choice != "none"
    force_tools = tool_choice not in (None, "none", "auto") or isinstance(
        tool_choice, dict
    )

    # System une seule fois (premier send de session)
    if include_system:
        for msg in messages:
            if msg.get("role") == "system":
                sys_c = _content_to_str(msg.get("content")).strip()
                if sys_c:
                    # Tronquer system très long pour le navigateur
                    max_sys = int(os.environ.get("NEMAPI_MAX_SYSTEM", "6000"))
                    if len(sys_c) > max_sys:
                        sys_c = sys_c[:max_sys] + "\n[... system tronqué ...]"
                    parts.append(f"[SYSTEM]\n{sys_c}")
                break

    if include_tools:
        parts.append(TOOL_PROTOCOL.strip())
        parts.append(_describe_tools(tools).strip())
        if force_tools or tool_choice == "required":
            parts.append(
                "[INSTRUCTION] Tu DOIS appeler au moins un outil via JSON tool_calls."
            )

    # Delta : dernier(s) message(s) utiles
    if not messages:
        body = ""
    elif _is_tool_result_batch(messages):
        # Tous les tool results en fin de liste
        batch: List[Dict[str, Any]] = []
        for msg in reversed(messages):
            if msg.get("role") == "tool":
                batch.append(msg)
            elif msg.get("role") == "user" and not batch:
                # user synthétique unique
                batch.append(msg)
                break
            else:
                break
        batch.reverse()
        chunks = []
        for m in batch:
            if m.get("role") == "tool":
                chunks.append(
                    f"[RÉSULTAT OUTIL `{m.get('name', 'outil')}`]\n"
                    f"{_content_to_str(m.get('content'))}"
                )
            else:
                chunks.append(_content_to_str(m.get("content")))
        body = "\n\n".join(chunks)
        parts.append(
            "[SUITE — résultats d'outils]\n"
            "Analyse et continue (JSON tool_calls ou réponse finale).\n\n"
            + body
        )
    else:
        # Dernier message user (ou assistant si seul)
        last_user = None
        for msg in reversed(messages):
            if msg.get("role") == "user":
                last_user = msg
                break
        if last_user:
            body = _content_to_str(last_user.get("content"))
            parts.append(f"[USER]\n{body}")
        else:
            last = messages[-1]
            body = _content_to_str(last.get("content"))
            parts.append(f"[{last.get('role', 'user').upper()}]\n{body}")

    if include_tools:
        parts.append(
            "\n[RAPPEL] Action système → JSON tool_calls. Sinon → texte clair."
        )

    text = "\n\n".join(p for p in parts if p and str(p).strip())
    max_chars = int(os.environ.get("NEMAPI_MAX_PROMPT", "24000"))
    if len(text) > max_chars:
        text = (
            text[: max_chars // 5]
            + f"\n\n[... tronqué {len(text)}→{max_chars} ...]\n\n"
            + text[-(4 * max_chars // 5) :]
        )
    return text


# Compat alias
def pack_messages_for_browser(
    messages: List[Dict[str, Any]],
    tools: Optional[List[Dict[str, Any]]] = None,
    tool_choice: Any = "auto",
) -> str:
    return pack_delta_for_browser(
        messages, tools=tools, tool_choice=tool_choice, include_system=True
    )


