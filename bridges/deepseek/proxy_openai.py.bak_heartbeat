class JobsManager:
    def __init__(self) -> None:
        self.jobs: Dict[str, Dict[str, Any]] = {}
        self.pending_queue: List[Dict[str, Any]] = []
        self._lock = asyncio.Lock()

    async def create_job(
        self,
        text: str,
        mode: str = "send",
        meta: Optional[Dict[str, Any]] = None,
    ) -> str:
        job_id = str(uuid.uuid4())
        event = asyncio.Event()
        # v2.3 : toujours send (regenerate abandonné — limite DeepSeek)
        job = {
            "id": job_id,
            "status": "pending",
            "question": text,  # compat extension ancienne
            "text": text,
            "mode": "send",
            "meta": meta or {},
            "result": None,
            "timestamp": datetime.now().isoformat(),
            "event": event,
        }
        mode = "send"
        async with self._lock:
            self.jobs[job_id] = job
            self.pending_queue.append(job)
        preview = text.replace("\n", " ")[:50]
        nfiles = len((meta or {}).get("files") or [])
        extra = f" files={nfiles}" if nfiles else ""
        print(f"[JOB] +{mode} {job_id[:8]}…{extra} — \"{preview}…\"")
        return job_id

    async def get_pending_job(self) -> Optional[Dict[str, Any]]:
        async with self._lock:
            while self.pending_queue:
                job = self.pending_queue[0]
                if job["status"] == "pending":
                    job["status"] = "in_progress"
                    self.pending_queue.pop(0)  # retiré dès prise en charge
                    return {
                        "id": job["id"],
                        "jobId": job["id"],
                        "question": job["text"],
                        "text": job["text"],
                        "mode": job["mode"],
                        "meta": job.get("meta") or {},
                        "status": job["status"],
                    }
                self.pending_queue.pop(0)
        return None

    async def set_result(self, job_id: str, result: str) -> bool:
        async with self._lock:
            job = self.jobs.get(job_id)
            if not job:
                return False
            # Idempotent : ignorer POST doublons (évite races)
            if job["status"] in ("completed", "error"):
                return True
            job["status"] = "completed"
            job["result"] = result
            job["event"].set()
            preview = (result or "").replace("\n", " ")[:60]
            print(f"[JOB] OK {job_id[:8]}… — \"{preview}…\"")
            return True

    async def set_error(self, job_id: str, error: str) -> bool:
        async with self._lock:
            job = self.jobs.get(job_id)
            if not job:
                return False
            if job["status"] in ("completed", "error"):
                return True
            job["status"] = "error"
            job["result"] = error
            job["event"].set()
            print(f"[JOB] ERR {job_id[:8]}… — {error[:80]}")
            return True

    def get_job(self, job_id: str) -> Optional[Dict[str, Any]]:
        return self.jobs.get(job_id)

    async def wait_job(self, job_id: str, timeout: float = 600.0) -> Dict[str, Any]:
        job = self.jobs.get(job_id)
        if not job:
            return {"status": "error", "result": "Job introuvable"}
        try:
            await asyncio.wait_for(job["event"].wait(), timeout=timeout)
        except asyncio.TimeoutError:
            return {"status": "error", "result": "Timeout: pas de réponse de l'extension"}
        return {"status": job["status"], "result": job.get("result")}

    async def cancel_all(self) -> None:
        async with self._lock:
            for job in self.jobs.values():
                if job["status"] in ("pending", "in_progress"):
                    job["status"] = "error"
                    job["result"] = "ANNULÉ"
                    job["event"].set()
            self.pending_queue.clear()


jobs_manager = JobsManager()


