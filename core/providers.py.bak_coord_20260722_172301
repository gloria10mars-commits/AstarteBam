import json, os, threading, urllib.request, urllib.error

OPENAI_PROVIDERS = {
    "groq": ("GROQ", "https://api.groq.com/openai/v1", "qwen/qwen3.6-27b"),
    "nvidia": ("NVIDIA", "https://integrate.api.nvidia.com/v1", "qwen/qwen3-next-80b-a3b-instruct"),
    "fireworks": ("FIREWORKS", "https://api.fireworks.ai/inference/v1", "accounts/fireworks/models/deepseek-v4-pro"),
}


def _normalize_content(content):
    """Garantit une string (Gemini renvoie parfois une liste de fragments)."""
    if content is None:
        return ""
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, dict):
                parts.append(str(item.get("text") or item.get("content") or ""))
            else:
                parts.append(str(item))
        return "".join(parts)
    if isinstance(content, dict):
        return str(content.get("text") or content.get("content") or content)
    return str(content)


class ProviderRegistry:
    def __init__(self, env=None):
        self.env = env or os.environ
        self.cursor = 0
        self.lock = threading.Lock()
        self.stats = {}

    def _env_url(self, name, default):
        raw = (self.env.get(name) or "").strip()
        return (raw or default).rstrip("/")

    def slots(self):
        out = []
        # Cloud Providers
        for name, (prefix, default_url, default_model) in OPENAI_PROVIDERS.items():
            for n in (1, 2):
                key = self.env.get(f"{prefix}_API_KEY_{n}", self.env.get(f"{prefix}_API_KEY", "") if n == 1 else "")
                key = (key or "").strip()
                if key:
                    out.append({
                        "provider": name, "slot": n, "key": key,
                        "url": self._env_url(f"{prefix}_BASE_URL", default_url),
                        "model": self.env.get(f"{prefix}_MODEL_{n}", self.env.get(f"{prefix}_MODEL", default_model)) or default_model,
                    })

        # DEEPSEEK (Local Bridge)
        if self.env.get("NEMAPI_ENABLED", "true").strip().lower() in ("1", "true", "yes", "on"):
            out.append({
                "provider": "nemapi", "slot": 1,
                "key": self.env.get("NEMAPI_KEY", "sk-deepseek-local") or "sk-deepseek-local",
                "url": self._env_url("NEMAPI_BASE_URL", "http://127.0.0.1:8080/v1"),
                "model": self.env.get("NEMAPI_MODEL", "deepseek-web") or "deepseek-web",
            })

        # GEMINI (Local Bridge)
        if self.env.get("GEMINI_ENABLED", "true").strip().lower() in ("1", "true", "yes", "on"):
            out.append({
                "provider": "gemini", "slot": 1, "key": "sk-gemini-local",
                "url": self._env_url("GEMINI_BASE_URL", "http://127.0.0.1:8081/v1"),
                "model": self.env.get("GEMINI_MODEL_1", "gemini-2.5-pro") or "gemini-2.5-pro",
            })

        # Cohere
        for n in (1, 2):
            key = self.env.get(f"COHERE_API_KEY_{n}", self.env.get("COHERE_API_KEY", "") if n == 1 else "")
            key = (key or "").strip()
            if key:
                out.append({
                    "provider": "cohere", "slot": n, "key": key,
                    "model": self.env.get(f"COHERE_MODEL_{n}", "command-a-03-2025"),
                    "url": "https://api.cohere.com/v2/chat",
                })
        return out

    def public_status(self):
        return [
            {
                "provider": x["provider"], "slot": x["slot"], "model": x["model"],
                "configured": True, **self.stats.get((x["provider"], x["slot"]), {}),
            }
            for x in self.slots()
        ]

    def ordered(self, preferred=None, preferred_slot=None):
        items = list(self.slots())
        if preferred:
            items.sort(key=lambda x: (
                0 if x["provider"] == preferred else 1,
                0 if str(x["slot"]) == str(preferred_slot) else 1,
            ))
        return items

    def call(self, messages, preferred=None, preferred_slot=None, strict=False):
        """Appelle un provider. strict=True : uniquement le preferred (pas de cascade)."""
        errors = []
        items = self.ordered(preferred, preferred_slot)
        if strict and preferred:
            items = [x for x in items if x["provider"] == preferred]
            if not items:
                return None, None, f"Provider strict '{preferred}' non configuré / indisponible"
        for slot in items:
            try:
                text = self._call_slot(slot, messages)
                self.stats[(slot["provider"], slot["slot"])] = {"state": "ok"}
                return text, slot, None
            except Exception as e:
                self.stats[(slot["provider"], slot["slot"])] = {"state": "error", "error": str(e)[:160]}
                errors.append("%s/%s: %s" % (slot["provider"], slot["slot"], e))
                # En mode strict, pas de cascade vers un autre provider
                if strict:
                    break
        return None, None, " | ".join(errors) or "Aucun fournisseur configuré"

    @staticmethod
    def _env_int(env, name, default):
        try:
            return int(str(env.get(name, "")).strip())
        except (TypeError, ValueError):
            return default

    def _check_bridge_alive(self, url, key):
        base_root = url.rsplit("/v1", 1)[0]
        last_err = None
        for h_path in ("/v1/health", "/health", "/"):
            try:
                req_h = urllib.request.Request(
                    base_root + h_path,
                    headers={"Authorization": "Bearer " + key},
                )
                with urllib.request.urlopen(req_h, timeout=3) as resp:
                    resp.read()
                return True, None
            except urllib.error.HTTPError:
                return True, None
            except Exception as e:
                last_err = e
        return False, last_err

    def _call_slot(self, s, messages):
        url, key = s["url"], s["key"]
        headers = {
            "Authorization": "Bearer " + key,
            "Content-Type": "application/json",
            "User-Agent": "AstarteBam/6.0",
        }

        if s["provider"] in ("nemapi", "gemini"):
            alive, err = self._check_bridge_alive(url, key)
            if not alive:
                raise RuntimeError(f"Bridge {s['provider']} hors ligne. ({err})")

        if s["provider"] == "cohere":
            body = {
                "model": s["model"],
                "messages": [{"role": m["role"], "content": m["content"]} for m in messages],
            }
            target_url = url
        else:
            body = {"model": s["model"], "messages": messages, "temperature": 0.7}
            target_url = url + "/chat/completions"

        req = urllib.request.Request(target_url, data=json.dumps(body).encode(), headers=headers)
        if s["provider"] == "nemapi":
            call_timeout = self._env_int(self.env, "NEMAPI_TIMEOUT", 600)
        elif s["provider"] == "gemini":
            call_timeout = self._env_int(self.env, "GEMINI_TIMEOUT", 300)
        else:
            call_timeout = self._env_int(self.env, "CALL_TIMEOUT", 150)

        with urllib.request.urlopen(req, timeout=call_timeout) as response:
            data = json.loads(response.read().decode())
            if s["provider"] == "cohere":
                return "".join(x.get("text", "") for x in data.get("message", {}).get("content", []))
            content = data["choices"][0]["message"]["content"]
            return _normalize_content(content)

    def nemapi_request(self, path, method="GET"):
        slot = next((x for x in self.slots() if x["provider"] == "nemapi"), None)
        if not slot:
            raise RuntimeError("NEMAPI désactivé")
        url = slot["url"].rstrip("/") + ("/" + path.lstrip("/") if path else "")
        req = urllib.request.Request(url, method=method, headers={"Authorization": "Bearer " + slot["key"]})
        return json.loads(urllib.request.urlopen(req, timeout=10).read().decode())

    def reset_nemapi_session(self):
        return self.nemapi_request("/sessions/reset", method="POST")

    def nemapi_status(self):
        try:
            return {"session": self.nemapi_request("/session"), "models": self.nemapi_request("/models")}
        except Exception:
            return {"session": {}, "models": []}

    def bridge_health(self):
        """État des bridges locaux pour le dashboard."""
        out = {}
        for name in ("nemapi", "gemini"):
            slot = next((x for x in self.slots() if x["provider"] == name), None)
            if not slot:
                out[name] = {"configured": False, "alive": False}
                continue
            alive, err = self._check_bridge_alive(slot["url"], slot["key"])
            out[name] = {"configured": True, "alive": alive, "model": slot["model"], "error": str(err) if err and not alive else None}
        return out
