# AstarteBam v6.0 — Configuration
# Serveur — local par défaut. Utilisez une adresse non locale uniquement avec une API_KEY forte.
HOST=127.0.0.1
ADMIN_HOST=127.0.0.1
PORT=8765
ADMIN_PORT=8766
API_KEY=
MAX_ACTIONS=20
MAX_CONTENT_SIZE=1048576

# Commandes sensibles : warn (journalise), block (refuse), allow (sans vérification)
COMMAND_POLICY=warn

# Worker mode: "api" ou "tampermonkey"
WORKER_MODE=api

# Orchestration : individual ou collaborative
ORCHESTRATION_MODE=individual
COLLAB_MAX_AGENTS=3

# Boucle de feedback

# Fournisseur IA du mode api : nvidia ou groq
AI_PROVIDER=nvidia
AI_SLOT=1

# Groq (mode api) — ne placez jamais une vraie clé dans Git
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# API NVIDIA (mode api)
NVIDIA_API_KEY=votre_cle_ici
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Pool multi-fournisseurs : au plus deux slots par fournisseur
GROQ_API_KEY_1=
GROQ_MODEL_1=qwen/qwen3.6-27b
GROQ_API_KEY_2=
GROQ_MODEL_2=qwen/qwen3.6-27b
NVIDIA_API_KEY_1=
NVIDIA_MODEL_1=qwen/qwen3-next-80b-a3b-instruct
NVIDIA_API_KEY_2=
NVIDIA_MODEL_2=qwen/qwen3-next-80b-a3b-instruct
FIREWORKS_API_KEY_1=
FIREWORKS_MODEL_1=accounts/fireworks/models/deepseek-v4-pro
FIREWORKS_API_KEY_2=
FIREWORKS_MODEL_2=accounts/fireworks/models/deepseek-v4-pro
COHERE_API_KEY_1=
COHERE_MODEL_1=command-a-03-2025
COHERE_API_KEY_2=
COHERE_MODEL_2=command-a-03-2025
# Les sessions Gemini sont stockées localement dans .secrets/gemini_slot_1.json et _2.json

# NEMAPI / DeepSeek Bridge local (sans clé API cloud)
# Démarrez d’abord le bridge Firefox, idéalement sur 127.0.0.1 uniquement.
NEMAPI_ENABLED=false
NEMAPI_BASE_URL=http://127.0.0.1:8080/v1
NEMAPI_MODEL=deepseek-web
NEMAPI_RESET_ON_NEW_TASK=true

# La boucle de feedback est illimitée : elle s’arrête uniquement avec actions: []

# Gemini Chat API (sessions locales dans .secrets/)
GEMINI_MODEL_1=gemini-2.5-pro
GEMINI_MODEL_2=gemini-2.5-pro
